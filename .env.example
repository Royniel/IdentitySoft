# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ===== Postgres =====
POSTGRES_DB=identity_db
POSTGRES_USER=identity_user
POSTGRES_PASSWORD=identity_pass

# ===== JWT =====
# Generate a real one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-see-comment-above
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ===== CORS =====
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Seed admin (created only if the users table is empty) =====
SEED_ADMIN_USERNAME=Nilanjan
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
